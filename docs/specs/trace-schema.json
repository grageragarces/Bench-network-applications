          "title": "Node",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        },
        "t": {
          "title": "T",
          "type": "number"
        },
        "utility": {
          "title": "Utility",
          "type": "number"
        }
      },
      "required": [
        "t",
        "role",
        "node",
        "success",
        "utility"
      ],
      "title": "AppOutcomeEvent",
      "type": "object"
