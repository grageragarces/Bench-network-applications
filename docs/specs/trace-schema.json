    "Demand": {
      "description": "The contract attached to a request for entanglement.\n\nThis is what makes the suite discriminative: schedulers read it, the trace\nrecords requested-vs-delivered against it, and the characterizer mines its\ndistribution across an application's run.",
      "properties": {
        "deadline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline"
        },
        "latency_budget": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Budget"
        },
        "min_fidelity": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Fidelity",
          "type": "number"
        },
        "priority": {
          "default": 1.0,
          "title": "Priority",
          "type": "number"
        },
        "purpose": {
          "default": "keep",
          "enum": [
            "keep",
            "measure"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "staleness_tolerance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Staleness Tolerance"
        }
      },
      "title": "Demand",
      "type": "object"
    },
    "EntanglementDelivered": {
